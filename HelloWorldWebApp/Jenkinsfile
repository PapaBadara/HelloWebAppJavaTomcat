pipeline {
    agent any

    environment {
        // Les variables APP_NAME et REPO_URL sont injectées par le paramétrage du Job Jenkins
        DOCKER_TAG  = "${env.BUILD_ID}"
    }

    stages {
        stage('Checkout') {
            steps {
                // Checkout du code (les credentials sont gérés par la configuration SCM du Job)
                checkout scm
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh """
                    sonar-scanner \
                      -Dsonar.projectKey=${APP_NAME} \
                      -Dsonar.projectName=${APP_NAME} \
                      -Dsonar.sources=.
                    """
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh "docker build -t ${APP_NAME}:${DOCKER_TAG} ."
            }
        }

        stage('Deploy to Preprod') {
            steps {
                // Arrêt et suppression de l'ancienne version
                sh "docker stop ${APP_NAME} || true"
                sh "docker rm ${APP_NAME} || true"
                
                // Déploiement sur le réseau du proxy sans exposer de port sur l'hôte
                sh """
                docker run -d \
                  --name ${APP_NAME} \
                  --network proxy-network \
                  --restart unless-stopped \
                  ${APP_NAME}:${DOCKER_TAG}
                """
            }
        }
    }

    post {
        always {
            // Nettoyage de l'image locale pour préserver le disque du serveur
            sh "docker rmi ${APP_NAME}:${DOCKER_TAG} || true"
            sh "docker image prune -f"
        }
    }
}